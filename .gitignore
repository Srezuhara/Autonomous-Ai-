# Python packaging build artefacts. All anchored to the repo root: these names
# are generic enough that an unanchored rule swallows unrelated source
# directories at any depth (an unanchored `lib/` used to hide
# frontend/src/lib/, which the whole frontend imports from).
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/

